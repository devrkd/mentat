# --- Models ---
# Per-role model selection, read by opencode.json via {env:...} interpolation.
# Every agent (plus the top-level model / small_model) is independently
# configurable, so switching vendors is a .env-only change.
# All ten variables must be set: an unset model var resolves to "" and breaks
# the runtime. Defaults reproduce the current DeepSeek setup.
# opencode does NOT auto-load .env — export the vars before starting opencode:
#   set -a; source .env; set +a
# Restart opencode after changing models; changes are not hot-reloaded.
OPENCODE_MODEL=deepseek/deepseek-v4-pro
OPENCODE_SMALL_MODEL=deepseek/deepseek-flash
ORCHESTRATOR_MODEL=deepseek/deepseek-flash
ORCHESTRATOR_VARIANT=low
ARCHITECT_MODEL=deepseek/deepseek-v4-pro
ARCHITECT_VARIANT=max
DEVELOPER_MODEL=deepseek/deepseek-v4-pro
DEVELOPER_VARIANT=max
STAFF_MODEL=deepseek/deepseek-v4-pro
STAFF_VARIANT=max

# --- Vendor presets (commented) ---
# To switch vendors, replace the defaults above with one of these complete
# sets. Model ids are provider-specific and change over time — verify each
# one before use (see hint below every preset). *_VARIANT is left empty for
# vendors without variants; an unset variant is benign.
#
# Anthropic (verify with: opencode models):
# OPENCODE_MODEL=anthropic/claude-sonnet-4-5
# OPENCODE_SMALL_MODEL=anthropic/claude-haiku-4-5
# ORCHESTRATOR_MODEL=anthropic/claude-haiku-4-5
# ORCHESTRATOR_VARIANT=
# ARCHITECT_MODEL=anthropic/claude-sonnet-4-5
# ARCHITECT_VARIANT=
# DEVELOPER_MODEL=anthropic/claude-sonnet-4-5
# DEVELOPER_VARIANT=
# STAFF_MODEL=anthropic/claude-sonnet-4-5
# STAFF_VARIANT=
#
# OpenAI (verify with: opencode models):
# OPENCODE_MODEL=openai/gpt-5
# OPENCODE_SMALL_MODEL=openai/gpt-5-mini
# ORCHESTRATOR_MODEL=openai/gpt-5-mini
# ORCHESTRATOR_VARIANT=
# ARCHITECT_MODEL=openai/gpt-5
# ARCHITECT_VARIANT=
# DEVELOPER_MODEL=openai/gpt-5
# DEVELOPER_VARIANT=
# STAFF_MODEL=openai/gpt-5
# STAFF_VARIANT=

# --- Source categories ---
# Each category is bound to a concrete MCP server in opencode.json (mcp.task /
# mcp.documentation / mcp.ux) or .mcp.json (Claude Code). See AGENTS.md for how
# to bind a provider. The tokens below are read by those bindings.
TASK_PROVIDER_TOKEN=replace_me
DOCUMENTATION_PROVIDER_TOKEN=replace_me
UX_PROVIDER_TOKEN=replace_me
GITHUB_TOKEN=replace_me

# --- Slack bridge (opencode plugin) ---
# Bot token from OAuth & Permissions (starts with xoxb-).
SLACK_BOT_TOKEN=replace_me
# App-level token for Socket Mode (starts with xapp-, needs connections:write).
SLACK_APP_TOKEN=replace_me
# Channel ID to post per-session threads into, e.g. C0123ABCD.
SLACK_CHANNEL=replace_me
# Comma-separated Slack user IDs allowed to answer approvals. Strongly recommended;
# if empty any member of the channel can approve agent commands.
SLACK_ALLOWED_USERS=
# Set to off to disable the bridge without removing the tokens above.
SLACK_BRIDGE=on
